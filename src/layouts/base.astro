---
import { Font } from 'astro:assets';

import Footer from '@/components/layout/footer.astro';
import Header from '@/components/layout/header.astro';
import '@/styles/global.css';

type Props = { title?: string; description?: string };

const {
  title = 'GeoThai: every place in Thailand, checked',
  description = 'Every province, district, subdistrict and postal code of Thailand, checked against official sources.',
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" href="/favicon.ico">
    <meta name="generator" content={Astro.generator}>
    <Font cssVariable="--font-bai-jamjuree" preload />
    <Font cssVariable="--font-jetbrains-mono" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="min-h-(--screen-below-header)">
      <slot />
    </main>
    <Footer />
  </body>
</html>
