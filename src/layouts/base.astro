---
import { Font } from 'astro:assets';

import Footer from '@/components/layout/footer.astro';
import Header from '@/components/layout/header.astro';
import '@/styles/global.css';

type Props = { title?: string; description?: string };

const {
  title = 'GeoThai: every place in Thailand, checked',
  description = 'Every province, district, subdistrict and postal code of Thailand, checked against official sources.',
} = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={url}>
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="sitemap" href="/sitemap-index.xml">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="GeoThai">
    <meta property="og:url" content={url}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={new URL('/og.png', Astro.site)}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="GeoThai: every place in Thailand, checked.">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="generator" content={Astro.generator}>
    <Font cssVariable="--font-bai-jamjuree" preload />
    <Font cssVariable="--font-jetbrains-mono" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="min-h-(--screen-below-header)">
      <slot />
    </main>
    <Footer />
  </body>
</html>
