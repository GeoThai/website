---
import Breadcrumb from '@/components/place/breadcrumb.astro';
import ListFilter from '@/components/place/list-filter.astro';
import Container from '@/components/ui/container.astro';
import Base from '@/layouts/base.astro';
import { loadData } from '@/lib/data';
import { count } from '@/utils/format';
import { breadcrumbs, graph } from '@/utils/schema';
import { areaSlug } from '@/utils/slug';

const { provinces, districts, subdistricts } = await loadData();
const rows = provinces.map((p) => ({
  ...p,
  href: `/${areaSlug(p)}/`,
  districts: districts.filter((d) => d.province_code === p.code).length,
  subdistricts: subdistricts.filter((s) => s.province_code === p.code).length,
}));
const page = new URL(Astro.url.pathname, Astro.site);
const trail = [{ label: 'Home', href: '/' }, { label: 'Provinces' }];
---

<Base
  jsonLd={graph(breadcrumbs(trail, page))}
  title="All 77 provinces of Thailand · GeoThai"
  description="Every province of Thailand with its code, Thai and English names, districts and subdistricts."
>
  <section id="provinces" aria-labelledby="provinces-title" class="py-18 md:py-24">
    <Container>
      <Breadcrumb trail={trail} />
      <h1 id="provinces-title" class="mt-10 text-title font-semibold tracking-tight text-balance">
        Provinces
      </h1>
      <p id="provinces-lead" class="mt-5 max-w-2xl text-xl leading-normal text-pretty text-slate">
        All {rows.length} provinces, sorted by code. Each one lists its districts, subdistricts and
        postal codes.
      </p>
      <ListFilter list="provinces-list" noun="provinces" placeholder="Name or code" class="mt-10" />
      <ul id="provinces-list" class="mt-6 border-t border-line">
        {rows.map((p) => (
          <li class="border-line border-b" data-keys={`${p.code} ${p.name_th} ${p.name_en}`}>
            <a
              href={p.href}
              class="grid gap-1 rounded-2xl px-3 py-4 transition-colors hover:bg-mist md:grid-cols-12 md:items-baseline md:gap-6"
            >
              <span class="font-mono text-slate text-sm tabular-nums md:col-span-1">{p.code}</span>
              <span class="font-semibold md:col-span-4">{p.name_th}</span>
              <span class="text-slate md:col-span-3">{p.name_en}</span>
              <span class="text-slate text-sm tabular-nums md:col-span-4 md:text-right">
                {`${count(p.districts, 'district')} · ${count(p.subdistricts, 'subdistrict')}`}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </section>
</Base>

<script>
  import { revealSection } from '@/lib/motion';

  const section = document.getElementById('provinces');
  const title = document.getElementById('provinces-title');
  const list = document.getElementById('provinces-list');
  if (section && title && list) {
    revealSection(section, title, document.getElementById('provinces-lead'), [...list.children]);
  }
</script>
