---
import { districtMap } from '@geothai/maps';
import AreaMap from '@/components/place/area-map.astro';
import Heading from '@/components/place/heading.astro';
import ListFilter from '@/components/place/list-filter.astro';
import LocatorMap from '@/components/place/locator-map.astro';
import Source from '@/components/place/source.astro';
import Container from '@/components/ui/container.astro';
import Base from '@/layouts/base.astro';
import { loadData, type Province, postalCodes } from '@/lib/data';
import { count } from '@/utils/format';
import { administrativeArea, breadcrumbs, graph } from '@/utils/schema';
import { areaSlug } from '@/utils/slug';

export async function getStaticPaths() {
  const { provinces } = await loadData();
  return provinces.map((province) => ({
    params: { province: areaSlug(province) },
    props: { province },
  }));
}

const { province } = Astro.props as { province: Province };
const { districts, subdistricts } = await loadData();
const inProvince = subdistricts.filter((s) => s.province_code === province.code);
const rows = districts
  .filter((d) => d.province_code === province.code)
  .map((d) => {
    const subs = inProvince.filter((s) => s.district_code === d.code);
    return {
      ...d,
      href: `/${areaSlug(province)}/${areaSlug(d)}/`,
      subdistricts: subs.length,
      postal: postalCodes(subs),
    };
  });
const postal = postalCodes(inProvince);
const hrefs = Object.fromEntries(rows.map((d) => [d.code, d.href]));
const page = new URL(Astro.url.pathname, Astro.site);
const trail = [
  { label: 'Home', href: '/' },
  { label: 'Provinces', href: '/provinces/' },
  { label: province.name_en },
];
---

<Base
  jsonLd={graph(administrativeArea(province, page), breadcrumbs(trail, page))}
  title={`${province.name_en} (${province.name_th}): districts and postal codes · GeoThai`}
  description={`${province.name_en} province, code ${province.code}: ${count(rows.length, 'district')}, ${count(inProvince.length, 'subdistrict')} and ${count(postal.length, 'postal code')}, checked against official sources.`}
>
  <section id="place" class="pt-10 pb-18 md:py-24">
    <Container class="grid grid-cols-1 gap-14">
      <Heading trail={trail} title={province.name_th}>
        {`${province.name_en} province, code ${province.code}. ${count(rows.length, 'district')}, ${count(inProvince.length, 'subdistrict')} and ${count(postal.length, 'postal code')}.`}
      </Heading>

      <AreaMap
        map={await districtMap(province.code)}
        hrefs={hrefs}
        title={`Districts of ${province.name_en}`}
      >
        <LocatorMap
          slot="inset"
          province={province.code}
          title={`${province.name_en} in Thailand`}
        />
      </AreaMap>

      <div>
        <h2 class="text-2xl font-semibold tracking-display">Districts</h2>
        <ListFilter
          list="place-districts"
          noun="districts"
          placeholder="Name or postal code"
          class="mt-5"
        />
        <ul id="place-districts" class="mt-6 border-t border-line">
          {rows.map((d) => (
            <li
              class="border-line border-b"
              data-keys={`${d.code} ${d.name_th} ${d.name_en} ${d.postal.join(' ')}`}
            >
              <a
                href={d.href}
                class="flex flex-wrap items-baseline gap-x-3 gap-y-1 rounded-panel px-3 py-4 transition-colors hover:bg-mist md:grid md:grid-cols-12 md:gap-6"
              >
                <span class="font-semibold md:col-span-3">{d.name_th}</span>
                <span class="text-slate md:col-span-3">{d.name_en}</span>
                <span class="basis-full md:hidden" aria-hidden="true"></span>
                <span class="text-slate text-sm tabular-nums md:order-first md:col-span-1">
                  {d.code}
                </span>
                <span class="text-slate text-sm md:col-span-2">
                  {count(d.subdistricts, 'subdistrict')}
                </span>
                <span class="text-slate text-sm tabular-nums md:col-span-3">
                  {d.postal.join(' ')}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <Source />
    </Container>
  </section>
</Base>

<script>
  import { revealSection } from '@/lib/motion';

  const section = document.getElementById('place');
  const title = document.getElementById('place-title');
  const list = document.getElementById('place-districts');
  if (section && title && list) {
    revealSection(section, title, document.getElementById('place-lead'), [...list.children]);
  }
</script>
