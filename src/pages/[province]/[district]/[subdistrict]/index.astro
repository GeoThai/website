---
import Breadcrumb from '@/components/place/breadcrumb.astro';
import Container from '@/components/ui/container.astro';
import Base from '@/layouts/base.astro';
import { DATA_VERSION, type District, loadData, type Province, type Subdistrict } from '@/lib/data';
import { highlightRecord, TONE } from '@/utils/record';
import { areaSlug } from '@/utils/slug';

export async function getStaticPaths() {
  const { provinces, districts, subdistricts } = await loadData();
  const provinceBy = new Map(provinces.map((p) => [p.code, p]));
  const districtBy = new Map(districts.map((d) => [d.code, d]));
  return subdistricts.map((subdistrict) => {
    const province = provinceBy.get(subdistrict.province_code);
    const district = districtBy.get(subdistrict.district_code);
    if (!province || !district) throw new Error(`subdistrict ${subdistrict.code}: parent missing`);
    return {
      params: {
        province: areaSlug(province),
        district: areaSlug(district),
        subdistrict: areaSlug(subdistrict),
      },
      props: { province, district, subdistrict },
    };
  });
}

const { province, district, subdistrict } = Astro.props as {
  province: Province;
  district: District;
  subdistrict: Subdistrict;
};
const provinceHref = `/${areaSlug(province)}/`;
const districtHref = `${provinceHref}${areaSlug(district)}/`;
const record = highlightRecord(subdistrict);
const many = subdistrict.postal_codes.length > 1;
---

<Base
  title={`${subdistrict.name_en} (${subdistrict.name_th}), ${district.name_en}, ${province.name_en}: postal code ${subdistrict.postal_codes.join(', ')} · GeoThai`}
  description={`${subdistrict.name_en} subdistrict in ${district.name_en}, ${province.name_en}, code ${subdistrict.code}, postal code ${subdistrict.postal_codes.join(', ')}.`}
>
  <section id="place" class="py-18 md:py-24">
    <Container class="grid gap-14">
      <div>
        <Breadcrumb
          trail={[
            { label: 'Home', href: '/' },
            { label: 'Provinces', href: '/provinces/' },
            { label: province.name_en, href: provinceHref },
            { label: district.name_en, href: districtHref },
            { label: subdistrict.name_en },
          ]}
        />
        <p class="mt-10 font-mono text-slate tabular-nums">{subdistrict.code}</p>
        <h1 id="place-title" class="mt-2 text-display font-semibold tracking-tight text-balance">
          {subdistrict.name_th}
        </h1>
        <p id="place-lead" class="mt-3 text-xl text-slate">
          {`${subdistrict.name_en} subdistrict, `}
          <a href={districtHref} class="underline underline-offset-4 hover:text-black">
            {district.name_en}
          </a>
          {', '}
          <a href={provinceHref} class="underline underline-offset-4 hover:text-black">
            {province.name_en}
          </a>
        </p>
      </div>

      <div class="grid gap-10 md:grid-cols-12 md:gap-6">
        <div data-item class="md:col-span-4">
          <h2 class="text-slate">{many ? 'Postal codes' : 'Postal code'}</h2>
          <p
            class="mt-3 flex flex-wrap gap-x-6 text-postal font-semibold tracking-tight tabular-nums"
          >
            {subdistrict.postal_codes.map((code) => (
              <a href={`/postal-codes/${code}/`} class="underline-offset-8 hover:underline">
                {code}
              </a>
            ))}
          </p>
        </div>
        <div data-item class="grid gap-3 md:col-span-8">
          <h2 class="text-slate">Record in <span class="font-mono">subdistricts.json</span></h2>
          <code
            class="block overflow-x-auto rounded-panel bg-black p-7 font-mono text-sm leading-relaxed"
          >
            {record.map((line) => (
              <span class="block whitespace-pre">
                {line.map((t) => (
                  <span class={TONE[t.tone]}>{t.text}</span>
                ))}
              </span>
            ))}
          </code>
        </div>
      </div>

      <p class="text-sm text-slate">
        From{' '}
        <a
          href={`https://github.com/GeoThai/data/releases/tag/${DATA_VERSION}`}
          class="font-mono underline underline-offset-4 hover:text-black"
        >
          GeoThai/data {DATA_VERSION}
        </a>
        .
      </p>
    </Container>
  </section>
</Base>

<script>
  import { revealSection } from '@/lib/motion';

  const section = document.getElementById('place');
  const title = document.getElementById('place-title');
  if (section && title) {
    revealSection(section, title, document.getElementById('place-lead'), [
      ...section.querySelectorAll('[data-item]'),
    ]);
  }
</script>
