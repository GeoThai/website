---
import Heading from '@/components/place/heading.astro';
import Source from '@/components/place/source.astro';
import Container from '@/components/ui/container.astro';
import RecordBlock from '@/components/ui/record-block.astro';
import Base from '@/layouts/base.astro';
import { type District, loadData, type Province, parentsOf, type Subdistrict } from '@/lib/data';
import { administrativeArea, breadcrumbs, graph } from '@/utils/schema';
import { areaSlug } from '@/utils/slug';

export async function getStaticPaths() {
  const data = await loadData();
  return data.subdistricts.map((subdistrict) => {
    const { province, district } = parentsOf(subdistrict, data);
    return {
      params: {
        province: areaSlug(province),
        district: areaSlug(district),
        subdistrict: areaSlug(subdistrict),
      },
      props: { province, district, subdistrict },
    };
  });
}

const { province, district, subdistrict } = Astro.props as {
  province: Province;
  district: District;
  subdistrict: Subdistrict;
};
const provinceHref = `/${areaSlug(province)}/`;
const districtHref = `${provinceHref}${areaSlug(district)}/`;
const many = subdistrict.postal_codes.length > 1;
const page = new URL(Astro.url.pathname, Astro.site);
const trail = [
  { label: 'Home', href: '/' },
  { label: 'Provinces', href: '/provinces/' },
  { label: province.name_en, href: provinceHref },
  { label: district.name_en, href: districtHref },
  { label: subdistrict.name_en },
];
---

<Base
  jsonLd={graph(
    administrativeArea(subdistrict, page, {
      parent: new URL(districtHref, page),
      postal: subdistrict.postal_codes,
    }),
    breadcrumbs(trail, page),
  )}
  title={`${subdistrict.name_en} (${subdistrict.name_th}), ${district.name_en}, ${province.name_en}: postal code ${subdistrict.postal_codes.join(', ')} · GeoThai`}
  description={`${subdistrict.name_en} subdistrict in ${district.name_en}, ${province.name_en}, code ${subdistrict.code}, postal code ${subdistrict.postal_codes.join(', ')}.`}
>
  <section id="place" class="pt-10 pb-18 md:py-24">
    <Container class="grid grid-cols-1 gap-14">
      <Heading trail={trail} title={subdistrict.name_th}>
        {`${subdistrict.name_en} subdistrict in `}
        <a href={districtHref} class="underline underline-offset-4 hover:text-black">
          {district.name_en}
        </a>
        {', '}
        <a href={provinceHref} class="underline underline-offset-4 hover:text-black">
          {province.name_en}
        </a>
        {`, code ${subdistrict.code}.`}
      </Heading>

      <div class="grid gap-10 md:grid-cols-12 md:gap-6">
        <div data-item class="md:col-span-4">
          <h2 class="text-slate">{many ? 'Postal codes' : 'Postal code'}</h2>
          <p
            class="mt-3 flex flex-wrap gap-x-6 text-postal font-semibold tracking-display tabular-nums"
          >
            {subdistrict.postal_codes.map((code) => (
              <a href={`/postal-codes/${code}/`} class="underline-offset-8 hover:underline">
                {code}
              </a>
            ))}
          </p>
        </div>
        <div data-item class="grid gap-3 md:col-span-8">
          <h2 class="text-slate">Record in subdistricts.json</h2>
          <RecordBlock record={subdistrict} />
        </div>
      </div>

      <Source />
    </Container>
  </section>
</Base>

<script>
  import { revealSection } from '@/lib/motion';

  const section = document.getElementById('place');
  const title = document.getElementById('place-title');
  if (section && title) {
    revealSection(section, title, document.getElementById('place-lead'), [
      ...section.querySelectorAll('[data-item]'),
    ]);
  }
</script>
