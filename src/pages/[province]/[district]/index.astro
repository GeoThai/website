---
import AreaMap from '@/components/place/area-map.astro';
import Heading from '@/components/place/heading.astro';
import ListFilter from '@/components/place/list-filter.astro';
import Source from '@/components/place/source.astro';
import Container from '@/components/ui/container.astro';
import Base from '@/layouts/base.astro';
import { type District, loadData, type Province, postalCodes } from '@/lib/data';
import { count } from '@/utils/format';
import { administrativeArea, breadcrumbs, graph } from '@/utils/schema';
import { areaSlug } from '@/utils/slug';

export async function getStaticPaths() {
  const { districts, provinceBy } = await loadData();
  return districts.map((district) => {
    const province = provinceBy.get(district.province_code);
    if (!province) throw new Error(`district ${district.code}: province missing`);
    return {
      params: { province: areaSlug(province), district: areaSlug(district) },
      props: { province, district },
    };
  });
}

const { province, district } = Astro.props as { province: Province; district: District };
const { districts, subdistricts } = await loadData();
const rows = subdistricts.filter((s) => s.district_code === district.code);
const postal = postalCodes(rows);
const provinceHref = `/${areaSlug(province)}/`;
const districtHref = `${provinceHref}${areaSlug(district)}/`;
const hrefs = Object.fromEntries(
  districts
    .filter((d) => d.province_code === province.code)
    .map((d) => [d.code, `${provinceHref}${areaSlug(d)}/`]),
);
const page = new URL(Astro.url.pathname, Astro.site);
const trail = [
  { label: 'Home', href: '/' },
  { label: 'Provinces', href: '/provinces/' },
  { label: province.name_en, href: provinceHref },
  { label: district.name_en },
];
---

<Base
  jsonLd={graph(
    administrativeArea(district, page, { parent: new URL(provinceHref, page) }),
    breadcrumbs(trail, page),
  )}
  title={`${district.name_en} (${district.name_th}), ${province.name_en}: subdistricts and postal codes · GeoThai`}
  description={`${district.name_en} district in ${province.name_en}, code ${district.code}: ${count(rows.length, 'subdistrict')} and postal codes ${postal.join(', ')}.`}
>
  <section id="place" class="pt-10 pb-18 md:py-24">
    <Container class="grid grid-cols-1 gap-14">
      <Heading trail={trail} title={district.name_th}>
        {`${district.name_en} district in `}
        <a href={provinceHref} class="underline underline-offset-4 hover:text-black">
          {province.name_en}
        </a>
        {`, code ${district.code}. ${count(rows.length, 'subdistrict')} and ${count(postal.length, 'postal code')}.`}
      </Heading>

      <AreaMap
        province={province.code}
        hrefs={hrefs}
        current={district.code}
        title={`${district.name_en} in ${province.name_en}`}
      />

      <div>
        <h2 class="text-2xl font-semibold tracking-display">Subdistricts</h2>
        <ListFilter
          list="place-subdistricts"
          noun="subdistricts"
          placeholder="Name or postal code"
          class="mt-5"
        />
        <ul id="place-subdistricts" class="mt-6 border-t border-line">
          {rows.map((s) => (
            <li
              class="border-line border-b"
              data-keys={`${s.code} ${s.name_th} ${s.name_en} ${s.postal_codes.join(' ')}`}
            >
              <a
                href={`${districtHref}${areaSlug(s)}/`}
                class="flex flex-wrap items-baseline gap-x-3 gap-y-1 rounded-panel px-3 py-4 transition-colors hover:bg-mist md:grid md:grid-cols-12 md:gap-6"
              >
                <span class="font-semibold md:col-span-4">{s.name_th}</span>
                <span class="text-slate md:col-span-3">{s.name_en}</span>
                <span class="basis-full md:hidden" aria-hidden="true"></span>
                <span class="text-slate text-sm tabular-nums md:order-first md:col-span-2">
                  {s.code}
                </span>
                <span class="text-slate text-sm tabular-nums md:col-span-3">
                  {s.postal_codes.join(' ')}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <Source />
    </Container>
  </section>
</Base>

<script>
  import { revealSection } from '@/lib/motion';

  const section = document.getElementById('place');
  const title = document.getElementById('place-title');
  const list = document.getElementById('place-subdistricts');
  if (section && title && list) {
    revealSection(section, title, document.getElementById('place-lead'), [...list.children]);
  }
</script>
