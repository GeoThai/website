---
import Breadcrumb from '@/components/place/breadcrumb.astro';
import Totals from '@/components/place/totals.astro';
import Container from '@/components/ui/container.astro';
import Base from '@/layouts/base.astro';
import { DATA_VERSION, type District, loadData, type Province } from '@/lib/data';
import { areaSlug } from '@/utils/slug';

export async function getStaticPaths() {
  const { provinces, districts } = await loadData();
  const byCode = new Map(provinces.map((p) => [p.code, p]));
  return districts.map((district) => {
    const province = byCode.get(district.province_code);
    if (!province) throw new Error(`district ${district.code}: province missing`);
    return {
      params: { province: areaSlug(province), district: areaSlug(district) },
      props: { province, district },
    };
  });
}

const { province, district } = Astro.props as { province: Province; district: District };
const { subdistricts } = await loadData();
const rows = subdistricts.filter((s) => s.district_code === district.code);
const postal = [...new Set(rows.flatMap((s) => s.postal_codes))].sort();
const provinceHref = `/${areaSlug(province)}/`;
const n = (x: number) => x.toLocaleString('en');
---

<Base
  title={`${district.name_en} (${district.name_th}), ${province.name_en}: subdistricts and postal codes · GeoThai`}
  description={`${district.name_en} district in ${province.name_en}, code ${district.code}: ${n(rows.length)} subdistricts and postal codes ${postal.join(', ')}.`}
>
  <section id="place" class="py-18 md:py-24">
    <Container class="grid gap-14">
      <div>
        <Breadcrumb
          trail={[
            { label: 'Home', href: '/' },
            { label: province.name_en, href: provinceHref },
            { label: district.name_en },
          ]}
        />
        <p class="mt-10 font-mono text-slate tabular-nums">{district.code}</p>
        <h1 id="place-title" class="mt-2 text-display font-semibold tracking-tight text-balance">
          {district.name_th}
        </h1>
        <p id="place-lead" class="mt-3 text-xl text-slate">
          {`${district.name_en} district, `}
          <a href={provinceHref} class="underline underline-offset-4 hover:text-black">
            {province.name_en}
          </a>
        </p>
      </div>

      <Totals
        items={[
          { n: rows.length, label: 'subdistricts' },
          { n: postal.length, label: 'postal codes' },
        ]}
      />

      <div>
        <h2 class="text-2xl font-semibold tracking-tight">Subdistricts</h2>
        <ul id="place-subdistricts" class="mt-5 border-t border-line">
          {rows.map((s) => (
            <li class="grid gap-1 border-line border-b px-3 py-4 md:grid-cols-12 md:items-baseline md:gap-6">
              <span class="font-mono text-slate text-sm tabular-nums md:col-span-2">{s.code}</span>
              <span class="font-semibold md:col-span-4">{s.name_th}</span>
              <span class="text-slate md:col-span-3">{s.name_en}</span>
              <span class="font-mono text-slate text-sm tabular-nums md:col-span-3">
                {s.postal_codes.join(' ')}
              </span>
            </li>
          ))}
        </ul>
      </div>

      <p class="text-sm text-slate">
        From{' '}
        <a
          href={`https://github.com/GeoThai/data/releases/tag/${DATA_VERSION}`}
          class="font-mono underline underline-offset-4 hover:text-black"
        >
          GeoThai/data {DATA_VERSION}
        </a>
        .
      </p>
    </Container>
  </section>
</Base>

<script>
  import { revealSection } from '@/lib/motion';

  const section = document.getElementById('place');
  const title = document.getElementById('place-title');
  const list = document.getElementById('place-subdistricts');
  if (section && title && list) {
    revealSection(section, title, document.getElementById('place-lead'), [...list.children]);
  }
</script>
