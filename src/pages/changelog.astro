---
import { Icon } from 'astro-icon/components';

import ReleaseMap from '@/components/changelog/release-map.astro';
import Button from '@/components/ui/button.astro';
import Container from '@/components/ui/container.astro';
import Base from '@/layouts/base.astro';
import { DATA_VERSION, downloadUrl, loadChangelog, loadData, releaseUrl } from '@/lib/data';
import { parseChangelog } from '@/utils/changelog';
import { count } from '@/utils/format';

const releases = parseChangelog(await loadChangelog());
const longDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
const OPEN_UP_TO = 20;

const { provinces, districts, subdistricts, byPostal } = await loadData();
const totals = `This release holds ${count(provinces.length, 'province')}, ${count(districts.length, 'district')}, ${count(subdistricts.length, 'subdistrict')} and ${count(byPostal.size, 'postal code')}.`;
---

<Base
  title="Changelog · GeoThai"
  description="Every GeoThai data release, newest first, with each area that changed."
>
  <section id="changelog" aria-labelledby="changelog-title" class="pt-10 pb-18 md:py-24">
    <Container class="grid gap-8 md:grid-cols-5 md:gap-20">
      <div class="md:col-span-2">
        <h1 id="changelog-title" class="text-title font-semibold tracking-display text-balance">
          Changelog
        </h1>
        <p id="changelog-lead" class="mt-5 max-w-xl text-xl leading-normal text-pretty text-slate">
          Every data release, newest first. A release comes only when an area, a name or a postal
          code changes.
        </p>
      </div>
      <ol id="releases" class="grid gap-14 md:col-span-3">
        {releases.map((r) => (
          <li class="border-line border-t pt-8">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <h2 class="font-medium text-2xl tabular-nums">{r.version}</h2>
              <a
                href={releaseUrl(r.version)}
                class="text-slate text-sm underline-offset-4 hover:text-black hover:underline"
              >
                Release on GitHub
              </a>
            </div>
            <div class="mt-1 flex items-start justify-between gap-6">
              <div>
                <time datetime={r.date} class="block text-slate text-sm">
                  {longDate(r.date)}
                </time>
                {r.notes.map((n) => (
                  <p class="mt-4 text-pretty">{n}</p>
                ))}
                {r.version === DATA_VERSION && <p class="mt-4 text-pretty">{totals}</p>}
              </div>
              {r.sections.length > 0 && (
                <ReleaseMap
                  codes={r.sections.flatMap((s) => s.changes.map((c) => c.code))}
                  version={r.version}
                />
              )}
            </div>
            {r.sections.map((s) => (
              <details
                open={s.changes.length <= OPEN_UP_TO}
                class="group mt-6 rounded-panel bg-mist"
              >
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-medium">
                  <span>{s.label}</span>
                  <span class="flex items-center gap-3 text-slate text-sm tabular-nums">
                    {count(s.count, 'area')}
                    <Icon
                      name="solar:alt-arrow-down-linear"
                      class="size-4 transition-transform group-open:rotate-180"
                      aria-hidden="true"
                    />
                  </span>
                </summary>
                <ul class="grid gap-1.5 px-5 pb-5 text-sm">
                  {s.changes.map((c) => (
                    <li class="flex gap-4">
                      <span class="shrink-0 text-slate tabular-nums">{c.code}</span>
                      <span class="wrap-anywhere">{c.detail}</span>
                    </li>
                  ))}
                </ul>
              </details>
            ))}
            <div class="mt-6 flex flex-wrap gap-3">
              <Button href={downloadUrl('json', r.version)} variant="quiet" size="sm">
                <Icon name="solar:download-minimalistic-linear" class="size-4" aria-hidden="true" />
                JSON
              </Button>
              <Button href={downloadUrl('csv', r.version)} variant="quiet" size="sm">
                <Icon name="solar:download-minimalistic-linear" class="size-4" aria-hidden="true" />
                CSV
              </Button>
            </div>
          </li>
        ))}
      </ol>
    </Container>
  </section>
</Base>

<script>
  import { revealSection } from '@/lib/motion';

  const section = document.getElementById('changelog');
  const title = document.getElementById('changelog-title');
  const list = document.getElementById('releases');
  if (section && title && list)
    revealSection(section, title, document.getElementById('changelog-lead'), [...list.children]);
</script>
