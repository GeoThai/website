---
import Breadcrumb from '@/components/place/breadcrumb.astro';
import ListFilter from '@/components/place/list-filter.astro';
import Container from '@/components/ui/container.astro';
import Base from '@/layouts/base.astro';
import { loadData } from '@/lib/data';
import { count } from '@/utils/format';
import { breadcrumbs, graph } from '@/utils/schema';

const { byPostal, provinceBy, districtBy } = await loadData();
const rows = [...byPostal].map(([code, places]) => {
  const inProvinces = [...new Set(places.map((s) => s.province_code))].flatMap(
    (c) => provinceBy.get(c) ?? [],
  );
  const inDistricts = [...new Set(places.map((s) => s.district_code))].flatMap(
    (c) => districtBy.get(c) ?? [],
  );
  return {
    code,
    count: places.length,
    where: inProvinces.map((p) => p.name_en).join(', '),
    keys: [code, ...[...inProvinces, ...inDistricts].map((a) => `${a.name_th} ${a.name_en}`)].join(
      ' ',
    ),
  };
});
const page = new URL(Astro.url.pathname, Astro.site);
const trail = [{ label: 'Home', href: '/' }, { label: 'Postal codes' }];
---

<Base
  jsonLd={graph(breadcrumbs(trail, page))}
  title={`All ${rows.length} postal codes of Thailand · GeoThai`}
  description="Every postal code of Thailand with the subdistricts, districts and provinces it covers."
>
  <section id="postal" aria-labelledby="postal-title" class="pt-10 pb-18 md:py-24">
    <Container>
      <Breadcrumb trail={trail} />
      <h1 id="postal-title" class="mt-10 text-title font-semibold tracking-display text-balance">
        Postal codes
      </h1>
      <p id="postal-lead" class="mt-5 max-w-2xl text-xl leading-normal text-pretty text-slate">
        All {rows.length} postal codes, sorted by code. Each one lists the subdistricts it covers.
      </p>
      <ListFilter
        list="postal-list"
        noun="postal codes"
        placeholder="Code or place"
        class="mt-10"
      />
      <ul id="postal-list" class="mt-6 border-t border-line">
        {rows.map((r) => (
          <li class="border-line border-b" data-keys={r.keys}>
            <a
              href={`/postal-codes/${r.code}/`}
              class="flex flex-wrap items-baseline gap-x-3 gap-y-1 rounded-panel px-3 py-4 transition-colors hover:bg-mist md:grid md:grid-cols-12 md:gap-6"
            >
              <span class="font-semibold tabular-nums md:col-span-2">{r.code}</span>
              <span class="text-slate text-sm tabular-nums md:order-last md:col-span-4 md:text-right">
                {count(r.count, 'subdistrict')}
              </span>
              <span class="basis-full md:hidden" aria-hidden="true"></span>
              <span class="text-slate md:col-span-6">{r.where}</span>
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </section>
</Base>

<script>
  import { revealSection } from '@/lib/motion';

  const section = document.getElementById('postal');
  const title = document.getElementById('postal-title');
  const list = document.getElementById('postal-list');
  if (section && title && list) {
    revealSection(section, title, document.getElementById('postal-lead'), [...list.children]);
  }
</script>
