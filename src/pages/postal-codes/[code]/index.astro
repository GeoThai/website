---
import { subdistrictMap } from '@geothai/maps';

import AreaMap from '@/components/place/area-map.astro';
import Heading from '@/components/place/heading.astro';
import ListFilter from '@/components/place/list-filter.astro';
import Source from '@/components/place/source.astro';
import Container from '@/components/ui/container.astro';
import Base from '@/layouts/base.astro';
import { loadData, parentsOf, type Subdistrict } from '@/lib/data';
import { count } from '@/utils/format';
import { breadcrumbs, graph } from '@/utils/schema';
import { areaSlug } from '@/utils/slug';

export async function getStaticPaths() {
  const { byPostal } = await loadData();
  return [...byPostal].map(([code, places]) => ({ params: { code }, props: { code, places } }));
}

const { code, places } = Astro.props as { code: string; places: Subdistrict[] };
const data = await loadData();
const rows = places.map((s) => {
  const { province, district } = parentsOf(s, data);
  return {
    ...s,
    district,
    province,
    href: `/${areaSlug(province)}/${areaSlug(district)}/${areaSlug(s)}/`,
  };
});
const inProvinces = [...new Map(rows.map((r) => [r.province.code, r.province])).values()];
const inDistricts = new Set(rows.map((r) => r.district.code)).size;
const where = inProvinces.map((p) => p.name_en).join(', ');
// One subdistrict map per district the code covers. Black: the code is the only one of the
// subdistrict. Slate: the subdistrict also uses another code.
const districtMaps = await Promise.all(
  [...new Map(rows.map((r) => [r.district.code, r])).values()].map(async (r) => {
    const map = await subdistrictMap(r.district.code);
    const inDistrict = data.subdistricts.filter((s) => s.district_code === r.district.code);
    const fills = Object.fromEntries(
      rows
        .filter((s) => s.district.code === r.district.code)
        .map((s) => [s.code, s.postal_codes.length === 1 ? '#000000' : '#5e636b']),
    );
    const hrefs = Object.fromEntries(
      inDistrict.map((s) => [
        s.code,
        `/${areaSlug(r.province)}/${areaSlug(r.district)}/${areaSlug(s)}/`,
      ]),
    );
    return { district: r.district, province: r.province, map, fills, hrefs };
  }),
);
const shared = rows.some((r) => r.postal_codes.length > 1);
const page = new URL(Astro.url.pathname, Astro.site);
const trail = [
  { label: 'Home', href: '/' },
  { label: 'Postal codes', href: '/postal-codes/' },
  { label: code },
];
---

<Base
  jsonLd={graph(breadcrumbs(trail, page))}
  title={`Postal code ${code}: ${count(rows.length, 'subdistrict')} in ${where} · GeoThai`}
  description={`Postal code ${code} covers ${count(rows.length, 'subdistrict')} in ${where}: ${rows.map((r) => r.name_en).join(', ')}.`}
>
  <section id="place" class="pt-10 pb-18 md:py-24">
    <Container class="grid grid-cols-1 gap-14">
      <Heading trail={trail} title={code}>
        {`Postal code for ${count(rows.length, 'subdistrict')} in ${count(inDistricts, 'district')} of ${where}.`}
      </Heading>

      <div class={districtMaps.length > 1 ? 'grid gap-6 md:grid-cols-2' : ''}>
        {districtMaps.map((m) => (
          <AreaMap
            map={m.map}
            hrefs={m.hrefs}
            fills={m.fills}
            title={`Subdistricts of ${m.district.name_en} that use ${code}`}
            caption={
              districtMaps.length > 1
                ? `${m.district.name_th} ${m.district.name_en}, ${m.province.name_en}`
                : undefined
            }
          />
        ))}
      </div>
      <p class="-mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate">
        <span class="flex items-center gap-2">
          <span class="inline-block size-3 rounded-full bg-black" aria-hidden="true"></span>
          {`Uses only ${code}`}
        </span>
        {shared && (
          <span class="flex items-center gap-2">
            <span class="inline-block size-3 rounded-full bg-slate" aria-hidden="true"></span>
            {`Uses ${code} and another postal code`}
          </span>
        )}
      </p>

      <div>
        <h2 class="text-2xl font-semibold tracking-display">Subdistricts</h2>
        {rows.length > 8 && (
          <ListFilter
            list="place-subdistricts"
            noun="subdistricts"
            placeholder="Name or code"
            class="mt-5"
          />
        )}
        <ul id="place-subdistricts" class="mt-6 border-t border-line">
          {rows.map((r) => (
            <li
              class="border-line border-b"
              data-keys={`${r.code} ${r.name_th} ${r.name_en} ${r.district.name_th} ${r.district.name_en}`}
            >
              <a
                href={r.href}
                class="flex flex-wrap items-baseline gap-x-3 gap-y-1 rounded-panel px-3 py-4 transition-colors hover:bg-mist md:grid md:grid-cols-12 md:gap-6"
              >
                <span class="font-semibold md:col-span-3">{r.name_th}</span>
                <span class="text-slate md:col-span-3">{r.name_en}</span>
                <span class="basis-full md:hidden" aria-hidden="true"></span>
                <span class="text-slate text-sm tabular-nums md:order-first md:col-span-2">
                  {r.code}
                </span>
                <span class="text-slate text-sm md:col-span-4">
                  {`${r.district.name_en}, ${r.province.name_en}`}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <Source />
    </Container>
  </section>
</Base>

<script>
  import { revealSection } from '@/lib/motion';

  const section = document.getElementById('place');
  const title = document.getElementById('place-title');
  const list = document.getElementById('place-subdistricts');
  if (section && title && list) {
    revealSection(section, title, document.getElementById('place-lead'), [...list.children]);
  }
</script>
