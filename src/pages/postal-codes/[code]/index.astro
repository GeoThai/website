---
import Heading from '@/components/place/heading.astro';
import ListFilter from '@/components/place/list-filter.astro';
import Source from '@/components/place/source.astro';
import Totals from '@/components/place/totals.astro';
import Container from '@/components/ui/container.astro';
import Base from '@/layouts/base.astro';
import { loadData, parentsOf, type Subdistrict } from '@/lib/data';
import { count, plural } from '@/utils/format';
import { areaSlug } from '@/utils/slug';

export async function getStaticPaths() {
  const { byPostal } = await loadData();
  return [...byPostal].map(([code, places]) => ({ params: { code }, props: { code, places } }));
}

const { code, places } = Astro.props as { code: string; places: Subdistrict[] };
const data = await loadData();
const rows = places.map((s) => {
  const { province, district } = parentsOf(s, data);
  return {
    ...s,
    district,
    province,
    href: `/${areaSlug(province)}/${areaSlug(district)}/${areaSlug(s)}/`,
  };
});
const inProvinces = [...new Map(rows.map((r) => [r.province.code, r.province])).values()];
const inDistricts = new Set(rows.map((r) => r.district.code)).size;
const where = inProvinces.map((p) => p.name_en).join(', ');
---

<Base
  title={`Postal code ${code}: ${count(rows.length, 'subdistrict')} in ${where} · GeoThai`}
  description={`Postal code ${code} covers ${count(rows.length, 'subdistrict')} in ${where}: ${rows.map((r) => r.name_en).join(', ')}.`}
>
  <section id="place" class="py-18 md:py-24">
    <Container class="grid grid-cols-1 gap-14">
      <Heading
        trail={[
          { label: 'Home', href: '/' },
          { label: 'Postal codes', href: '/postal-codes/' },
          { label: code },
        ]}
        kicker="Postal code"
        title={code}
      >
        {`${count(rows.length, 'subdistrict')} in ${where}`}
      </Heading>

      <Totals
        items={[
          { n: rows.length, label: plural(rows.length, 'subdistrict') },
          { n: inDistricts, label: plural(inDistricts, 'district') },
          { n: inProvinces.length, label: plural(inProvinces.length, 'province') },
        ]}
      />

      <div>
        <h2 class="text-2xl font-semibold tracking-tight">Subdistricts</h2>
        {rows.length > 8 && (
          <ListFilter
            list="place-subdistricts"
            noun="subdistricts"
            placeholder="Name or code"
            class="mt-5"
          />
        )}
        <ul id="place-subdistricts" class="mt-6 border-t border-line">
          {rows.map((r) => (
            <li
              class="border-line border-b"
              data-keys={`${r.code} ${r.name_th} ${r.name_en} ${r.district.name_th} ${r.district.name_en}`}
            >
              <a
                href={r.href}
                class="grid gap-1 rounded-2xl px-3 py-4 transition-colors hover:bg-mist md:grid-cols-12 md:items-baseline md:gap-6"
              >
                <span class="font-mono text-slate text-sm tabular-nums md:col-span-2">
                  {r.code}
                </span>
                <span class="font-semibold md:col-span-3">{r.name_th}</span>
                <span class="text-slate md:col-span-3">{r.name_en}</span>
                <span class="text-slate text-sm md:col-span-4">
                  {`${r.district.name_en}, ${r.province.name_en}`}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <Source />
    </Container>
  </section>
</Base>

<script>
  import { revealSection } from '@/lib/motion';

  const section = document.getElementById('place');
  const title = document.getElementById('place-title');
  const list = document.getElementById('place-subdistricts');
  if (section && title && list) {
    revealSection(section, title, document.getElementById('place-lead'), [...list.children]);
  }
</script>
