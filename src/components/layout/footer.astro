---
import Logo from '@/assets/logo.svg';
import Container from '@/components/ui/container.astro';
import { ORG_URL, REPO_URL } from '@/lib/data';
---

<footer class="mt-24 border-t border-line py-14 text-sm text-slate">
  <Container class="flex flex-wrap justify-between gap-x-12 gap-y-6">
    <div>
      <Logo class="-ml-2 h-8 w-auto" aria-hidden="true" />
      <p class="mt-3">Every place in Thailand, checked.</p>
    </div>
    <ul class="grid gap-1.5">
      <li><a class="hover:text-black" href="/provinces/">Provinces</a></li>
      <li><a class="hover:text-black" href="/postal-codes/">Postal codes</a></li>
      <li><a class="hover:text-black" href="/docs/">Docs</a></li>
      <li><a class="hover:text-black" href="/changelog/">Changelog</a></li>
      <li><a class="hover:text-black" href={REPO_URL}>Data on GitHub</a></li>
      <li><a class="hover:text-black" href={ORG_URL}>GeoThai on GitHub</a></li>
    </ul>
    <p class="max-w-xs">
      Data from the Department of Provincial Administration and Thailand Post. Type: Bai Jamjuree
      (OFL).
    </p>
  </Container>
</footer>
