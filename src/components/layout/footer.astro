---
import Logo from '@/assets/logo.svg';
import Container from '@/components/ui/container.astro';
import { DATA_VERSION, ORG_URL, REPO_URL, releaseUrl } from '@/lib/data';

const groups = [
  {
    title: 'Explore',
    links: [
      { href: '/provinces/', label: 'Provinces' },
      { href: '/postal-codes/', label: 'Postal codes' },
      { href: '/changelog/', label: 'Changelog' },
    ],
  },
  {
    title: 'Developers',
    links: [
      { href: '/docs/', label: 'Docs' },
      { href: 'https://www.npmjs.com/package/geothai', label: 'npm package' },
      { href: 'https://pypi.org/project/geothai/', label: 'Python package' },
    ],
  },
  {
    title: 'GitHub',
    links: [
      { href: REPO_URL, label: 'GeoThai/data' },
      { href: ORG_URL, label: 'GeoThai' },
    ],
  },
];

const credit = 'whitespace-nowrap underline underline-offset-4 transition-colors hover:text-black';
---

<footer class="mt-24 border-t border-line text-sm">
  <Container>
    <div class="grid gap-12 py-14 md:grid-cols-12 md:gap-6">
      <div class="md:col-span-5">
        <a href="/" class="-ml-2 inline-flex">
          <span class="sr-only">GeoThai home</span>
          <Logo class="h-8 w-auto" aria-hidden="true" />
        </a>
        <p class="mt-3 max-w-xs text-pretty text-slate">
          Every province, district, subdistrict and postal code of Thailand, checked against
          official sources.
        </p>
      </div>
      <nav
        aria-label="Footer"
        class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 md:col-span-7"
      >
        {groups.map((g) => (
          <div>
            <h2 class="font-semibold">{g.title}</h2>
            <ul class="mt-4 grid gap-3">
              {g.links.map((l) => (
                <li>
                  <a href={l.href} class="text-slate transition-colors hover:text-black">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <div class="grid gap-3 border-t border-line py-8 text-slate text-xs md:grid-cols-12 md:gap-6">
      <p class="md:col-span-5">
        Data{' '}
        <a href={releaseUrl()} class={`font-mono ${credit}`}>{DATA_VERSION}</a>
        {' '}under{' '}
        <a href="https://creativecommons.org/licenses/by/4.0/" class={credit}>CC BY 4.0</a>. Credit
        “GeoThai”.
      </p>
      <p class="text-pretty md:col-span-7">
        Sources: Department of Provincial Administration, Thailand Post and thailand-geography-json,{' '}
        <a href={`${REPO_URL}/blob/main/NOTICE`} class={credit}>notice</a>. Type: Bai Jamjuree and
        JetBrains Mono, OFL. Icons:{' '}
        <a href="https://www.figma.com/community/file/1166831539721848736" class={credit}>Solar</a>
        {' '}
        by 480 Design,{' '}
        <a href="https://creativecommons.org/licenses/by/4.0/" class={credit}>CC BY 4.0</a>.
      </p>
    </div>
  </Container>
</footer>
