---
import Logo from '@/assets/logo.svg';
---

<footer class="mt-24 border-t border-line py-14 text-sm text-slate">
  <div class="mx-auto flex w-[min(100%-2*clamp(20px,4vw,56px),1200px)] flex-wrap justify-between gap-x-12 gap-y-6">
    <div>
      <Logo class="-ml-2 h-8 w-auto" aria-hidden="true" />
      <p class="mt-3">Every place in Thailand, checked.</p>
    </div>
    <ul class="grid gap-1.5">
      <li><a class="hover:text-black" href="https://github.com/GeoThai/data">Data on GitHub</a></li>
      <li><a class="hover:text-black" href="https://github.com/GeoThai">GeoThai on GitHub</a></li>
    </ul>
    <p class="max-w-[44ch]">
      Data from the Department of Provincial Administration and Thailand Post. Type: Bai Jamjuree (OFL).
    </p>
  </div>
</footer>
