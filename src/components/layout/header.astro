---
import Logo from '@/assets/logo.svg';
import Button from '@/components/ui/button.astro';
import Container from '@/components/ui/container.astro';
import { REPO_URL } from '@/lib/data';

const path = Astro.url.pathname;
const links = [
  {
    href: '/provinces/',
    label: 'Provinces',
    active: path === '/provinces/' || /^\/\d{2}-/.test(path),
  },
  { href: '/postal-codes/', label: 'Postal codes', active: path.startsWith('/postal-codes/') },
  { href: '/docs/', label: 'Docs', active: path.startsWith('/docs/') },
  { href: '/changelog/', label: 'Changelog', active: path.startsWith('/changelog/') },
];
---

<header
  id="site-header"
  class="sticky top-0 z-20 h-(--header-height) animate-fade-down pt-4 motion-reduce:animate-none"
>
  <Container class="relative h-16">
    <nav
      aria-label="Main"
      class="flex h-full items-center gap-6 rounded-full bg-white/50 py-2 pr-2 pl-5 backdrop-blur-xl"
    >
      <a href="/" class="mr-auto">
        <span class="sr-only">GeoThai home</span>
        <Logo class="h-10 w-auto" aria-hidden="true" />
      </a>
      <ul class="flex items-center gap-1 max-md:hidden">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={l.active ? 'page' : undefined}
              class="rounded-full px-3.5 py-2 text-slate text-sm transition-colors hover:text-black aria-[current=page]:text-black"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <span
        id="header-cta"
        data-collapsed={path === '/' ? '' : undefined}
        inert={path === '/'}
        class="flex max-w-48 overflow-hidden rounded-full transition-all duration-700 ease-pill data-collapsed:-ml-6 data-collapsed:max-w-0 data-collapsed:opacity-0 max-md:hidden motion-reduce:transition-none"
      >
        <Button href={REPO_URL} class="whitespace-nowrap">Get the data</Button>
      </span>
      <button
        id="menu-button"
        type="button"
        aria-expanded="false"
        aria-controls="menu-panel"
        class="group inline-flex size-12 items-center justify-center rounded-full transition hover:bg-mist active:scale-97 md:hidden"
      >
        <span class="sr-only">Menu</span>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          class="size-6"
          aria-hidden="true"
        >
          <!-- Solar hamburger-menu-linear morphing into close-linear: 2 drops onto 3, 1 swings down, 3 swings up. -->
          <line
            x1="4"
            y1="7"
            x2="20"
            y2="7"
            transform-origin="4 7"
            vector-effect="non-scaling-stroke"
            class="transition-all delay-150 duration-150 ease-pill group-aria-expanded:translate-x-px group-aria-expanded:-translate-y-0.5 group-aria-expanded:rotate-45 group-aria-expanded:scale-x-124 motion-reduce:transition-none"
          />
          <g
            class="transition-opacity delay-150 duration-0 group-aria-expanded:opacity-0 group-aria-expanded:delay-300"
          >
            <line
              x1="4"
              y1="12"
              x2="20"
              y2="12"
              class="transition-all delay-300 duration-150 ease-pill group-aria-expanded:translate-y-1.25 group-aria-expanded:delay-0 motion-reduce:transition-none"
            />
          </g>
          <line
            x1="4"
            y1="17"
            x2="20"
            y2="17"
            transform-origin="4 17"
            vector-effect="non-scaling-stroke"
            class="transition-all duration-150 ease-pill group-aria-expanded:translate-x-px group-aria-expanded:translate-y-0.5 group-aria-expanded:-rotate-45 group-aria-expanded:scale-x-124 group-aria-expanded:delay-300 motion-reduce:transition-none"
          />
        </svg>
      </button>
    </nav>

    <nav
      id="menu-panel"
      aria-label="Menu"
      class="invisible absolute inset-x-5 top-full mt-2 grid origin-top -translate-y-2 scale-98 gap-6 rounded-panel border border-line bg-white/70 p-6 opacity-0 backdrop-blur-2xl backdrop-saturate-150 transition-all duration-300 ease-pill data-open:visible data-open:translate-y-0 data-open:scale-100 data-open:opacity-100 motion-reduce:transition-none md:hidden"
    >
      <ul class="grid">
        {links.map((l) => (
          <li class="border-line border-b last:border-b-0">
            <a
              href={l.href}
              aria-current={l.active ? 'page' : undefined}
              class="block py-3.5 font-semibold text-2xl text-slate tracking-tight aria-[current=page]:text-black"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <Button href={REPO_URL}>Get the data</Button>
    </nav>
  </Container>
</header>

<script>
  const button = document.getElementById('menu-button');
  const panel = document.getElementById('menu-panel');

  const isOpen = () => button?.getAttribute('aria-expanded') === 'true';
  const setOpen = (open: boolean) => {
    if (!button || !panel) return;
    button.setAttribute('aria-expanded', String(open));
    panel.toggleAttribute('data-open', open);
  };

  button?.addEventListener('click', () => setOpen(!isOpen()));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) {
      setOpen(false);
      button?.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (isOpen() && !document.getElementById('site-header')?.contains(e.target as Node))
      setOpen(false);
  });
  const cta = document.getElementById('header-cta');
  const sentinel = document.querySelector('[data-cta-sentinel]');
  if (cta && sentinel) {
    new IntersectionObserver(([entry]) => {
      const hide = entry?.isIntersecting ?? false;
      cta.toggleAttribute('data-collapsed', hide);
      cta.inert = hide;
    }).observe(sentinel);
  }
  matchMedia('(min-width: 48rem)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
