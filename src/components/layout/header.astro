---
import Logo from '@/assets/logo.svg';
import Button from '@/components/ui/button.astro';
import Container from '@/components/ui/container.astro';
---

<header
  class="sticky top-0 z-20 h-(--header-height) animate-fade-down border-b border-line bg-white/90 backdrop-blur-md motion-reduce:animate-none"
>
  <Container as="nav" aria-label="Main" class="flex h-full items-center justify-between gap-6">
    <a href="/" class="-ml-3">
      <span class="sr-only">GeoThai home</span>
      <Logo class="h-10 w-auto" aria-hidden="true" />
    </a>
    <Button href="https://github.com/GeoThai/data" size="sm">Get the data</Button>
  </Container>
</header>
