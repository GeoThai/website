---
import Logo from '@/assets/logo.svg';
---

<header class="sticky top-0 z-20 border-b border-line bg-white/90 backdrop-blur-md">
  <nav aria-label="Main" class="mx-auto flex h-18 w-[min(100%-2*clamp(20px,4vw,56px),1200px)] items-center justify-between gap-6">
    <a href="/" aria-label="GeoThai home" class="-ml-3">
      <Logo class="h-10 w-auto" aria-hidden="true" />
    </a>
    <a
      href="https://github.com/GeoThai/data"
      class="inline-flex min-h-10 items-center rounded-full bg-black px-[18px] text-sm font-medium text-white transition-transform active:scale-[0.97]"
    >
      Get the data
    </a>
  </nav>
</header>
