---
import Logo from '@/assets/logo.svg';
import Button from '@/components/ui/button.astro';
import Container from '@/components/ui/container.astro';
---

<header class="sticky top-0 z-20 border-b border-line bg-white/90 backdrop-blur-md">
  <Container as="nav" aria-label="Main" class="flex h-18 items-center justify-between gap-6">
    <a href="/" aria-label="GeoThai home" class="-ml-3">
      <Logo class="h-10 w-auto" aria-hidden="true" />
    </a>
    <Button href="https://github.com/GeoThai/data" size="sm">Get the data</Button>
  </Container>
</header>
