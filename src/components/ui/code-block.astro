---
import { Code } from 'astro:components';

import { cn } from '@/utils/cn';

type Props = { code: string; lang?: 'json' | 'js' | 'python' | 'sh'; class?: string };

const { code, lang = 'sh', class: className } = Astro.props;
---

<Code
  code={code.replace(/\n$/, '')}
  lang={lang}
  theme="poimandres"
  class={cn('block rounded-panel bg-black! p-7 font-mono text-sm leading-relaxed', className)}
/>
