---
import type { HTMLAttributes } from 'astro/types';

import { cn } from '@/utils/cn';

type Props = (HTMLAttributes<'a'> | HTMLAttributes<'button'>) & {
  href?: string;
  variant?: 'primary' | 'quiet';
  size?: 'sm' | 'md';
};

const { href, variant = 'primary', size = 'md', class: className, ...rest } = Astro.props;

const classes = cn(
  'inline-flex items-center justify-center gap-2 rounded-full border font-medium transition active:scale-97',
  variant === 'primary' && 'border-black bg-black text-white hover:bg-black/85',
  variant === 'quiet' && 'border-line bg-transparent text-black hover:bg-mist',
  size === 'sm' && 'min-h-10 px-4.5 text-sm',
  size === 'md' && 'min-h-12 px-6 text-base',
  className,
);
---

{
  href ? (
    <a href={href} class={classes} {...(rest as HTMLAttributes<'a'>)}>
      <slot />
    </a>
  ) : (
    <button type="button" class={classes} {...(rest as HTMLAttributes<'button'>)}>
      <slot />
    </button>
  )
}
