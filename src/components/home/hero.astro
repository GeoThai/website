---
import SymbolWhite from '@/assets/symbol-white.svg';
import HandCard from '@/components/home/hand-card.astro';
import Container from '@/components/ui/container.astro';
import Input from '@/components/ui/input.astro';
import { startPlace } from '@/lib/data';

const { province: prov, district: dist, subdistrict: sub } = await startPlace();

const cards = [
  {
    level: 'Province',
    th: prov.name_th,
    en: prov.name_en,
    code: prov.code,
    f: ['5', '6', 'pc'],
    fan: '-rotate-9 translate-y-7',
  },
  {
    level: 'District',
    th: dist.name_th,
    en: dist.name_en,
    code: dist.code,
    f: ['3', '4', 'dc'],
    fan: '-rotate-3 translate-y-1.5',
  },
  {
    level: 'Subdistrict',
    th: sub.name_th,
    en: sub.name_en,
    code: sub.code,
    f: ['1', '2', '0'],
    fan: 'rotate-3 translate-y-1.5',
  },
];
---

<section id="top" aria-labelledby="hero-title" class="overflow-hidden pt-6 pb-16 md:pt-14 md:pb-32">
  <Container class="grid justify-items-center text-center">
    <h1 id="hero-title" class="max-w-2xl text-display font-semibold tracking-tight text-balance">
      Find any place in Thailand, down to the subdistrict.
    </h1>
    <p id="hero-lead" class="mt-5 max-w-xl text-xl leading-normal text-pretty text-slate">
      Province, district, subdistrict and postal code, from one search. Every value is checked
      against official sources.
    </p>

    <search
      id="hero-search"
      data-cta-sentinel
      class="relative z-10 mt-7 w-full max-w-140 text-left"
    >
      <label class="sr-only" for="q">Search a place</label>
      <Input
        icon="solar:magnifer-linear"
        id="q"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="Find a place or postal code"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-controls="q-list"
      />
      <ul
        id="q-list"
        hidden
        class="absolute inset-x-0 top-16 z-20 max-h-96 overflow-y-auto overscroll-contain rounded-3xl border border-line bg-white p-1.5"
      ></ul>
      <p id="q-status" aria-live="polite" class="mt-2.5 min-h-6 text-center text-sm text-slate"></p>
    </search>

    <div
      id="hand"
      role="status"
      aria-label="Where the place sits"
      class="relative mt-5 flex h-85 w-full justify-center max-md:h-57.5 max-md:origin-top max-md:scale-84"
    >
      {cards.map((c) => (
        <HandCard tone={c.level === 'Province' ? 'mist' : 'white'} class={c.fan}>
          <p class="mb-4.5 text-slate text-sm max-md:mb-2">{c.level}</p>
          <p
            data-f={c.f[0]}
            class="wrap-break-word font-semibold text-card tracking-tight max-md:text-base"
          >
            {c.th}
          </p>
          <p data-f={c.f[1]} class="line-clamp-2 text-slate max-md:text-sm">
            {c.en}
          </p>
          <p data-f={c.f[2]} class="mt-auto font-medium text-slate tabular-nums max-md:text-sm">
            {c.code}
          </p>
        </HandCard>
      ))}
      <HandCard tone="black" class="rotate-9 translate-y-7">
        <p class="mb-4.5 text-sm text-white/65 max-md:mb-2">Postal code</p>
        <p
          data-f="7"
          data-many={sub.postal_codes.length > 1 ? '' : undefined}
          class="text-postal font-semibold tracking-tight tabular-nums wrap-anywhere data-many:text-4xl data-many:leading-tight max-md:text-2xl max-md:data-many:text-xl"
        >
          {sub.postal_codes.join(' ')}
        </p>
        <SymbolWhite
          class="absolute right-5.5 bottom-5.5 h-auto w-7 max-md:right-3.5 max-md:bottom-3.5 max-md:w-5"
          aria-hidden="true"
        />
      </HandCard>
    </div>
  </Container>
</section>

<script>
  import { gsap } from 'gsap';
  import { SplitText } from 'gsap/SplitText';

  import { type Row, searchRows } from '@/utils/search';

  gsap.registerPlugin(SplitText);
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hand = document.getElementById('hand');
  const cards = hand ? [...hand.children].filter((c) => c instanceof HTMLElement) : [];
  const ROT = [-9, -3, 3, 9];
  const LIFT = [28, 6, 6, 28];

  function fill(r: Row) {
    const values: Record<string, string> = {
      0: r[0],
      1: r[1],
      2: r[2],
      3: r[3],
      4: r[4],
      5: r[5],
      6: r[6],
      pc: r[0].slice(0, 2),
      dc: r[0].slice(0, 4),
    };
    for (const el of hand?.querySelectorAll<HTMLElement>('[data-f]') ?? []) {
      const f = el.dataset.f ?? '';
      if (f === '7') {
        el.textContent = r[7].join(' ');
        el.toggleAttribute('data-many', r[7].length > 1);
      } else el.textContent = values[f] ?? '';
    }
  }

  function deal(r: Row) {
    if (reduce) return fill(r);
    gsap
      .timeline()
      .to(cards, {
        y: 60,
        opacity: 0,
        rotation: 0,
        duration: 0.28,
        ease: 'power2.in',
        stagger: 0.04,
      })
      .add(() => fill(r))
      .fromTo(
        cards,
        { x: -80, y: 40, rotation: -14, opacity: 0 },
        {
          x: 0,
          y: (i) => LIFT[i] ?? 0,
          rotation: (i) => ROT[i] ?? 0,
          opacity: 1,
          duration: 0.7,
          ease: 'back.out(1.4)',
          stagger: 0.07,
        },
      );
  }

  const input = document.getElementById('q') as HTMLInputElement | null;
  const list = document.getElementById('q-list');
  const status = document.getElementById('q-status');
  let rows: Row[] = [];
  let results: Row[] = [];
  let active = -1;

  const PAGE = 60;

  function option(r: Row, i: number) {
    const li = document.createElement('li');
    li.id = `q-${i}`;
    li.dataset.index = String(i);
    li.setAttribute('role', 'option');
    li.setAttribute('aria-selected', 'false');
    li.className =
      'flex cursor-pointer items-center justify-between gap-4 rounded-2xl px-3.5 py-2.5 hover:bg-mist aria-selected:bg-mist';
    const text = document.createElement('span');
    const name = document.createElement('span');
    name.className = 'block font-semibold';
    name.textContent = `${r[1]}  ${r[2]}`;
    const path = document.createElement('span');
    path.className = 'block text-sm text-slate';
    path.textContent = `${r[3]}, ${r[5]} · ${r[0]}`;
    text.append(name, path);
    const postal = document.createElement('span');
    postal.className = 'shrink-0 text-slate tabular-nums';
    postal.textContent = r[7].join(', ');
    li.append(text, postal);
    return li;
  }

  // Thousands of matches are possible, so options are added a page at a time as the list scrolls.
  function grow(until: number) {
    if (!list) return;
    const from = list.children.length;
    if (until <= from) return;
    const to = Math.min(results.length, Math.max(until, from + PAGE));
    list.append(...results.slice(from, to).map((r, k) => option(r, from + k)));
  }

  function select(i: number) {
    list?.querySelector('[aria-selected="true"]')?.setAttribute('aria-selected', 'false');
    active = i;
    if (i >= 0) grow(i + 1);
    const li = document.getElementById(`q-${i}`);
    li?.setAttribute('aria-selected', 'true');
    li?.scrollIntoView({ block: 'nearest' });
    input?.setAttribute('aria-activedescendant', li ? li.id : '');
  }

  function render() {
    if (!input || !list) return;
    list.replaceChildren();
    grow(PAGE);
    list.scrollTop = 0;
    list.hidden = results.length === 0;
    input.setAttribute('aria-expanded', String(results.length > 0));
    select(results.length ? 0 : -1);
  }

  function pick(i: number) {
    const r = results[i];
    if (!r || !input || !status) return;
    input.value = r[1];
    results = [];
    render();
    status.textContent = `${r[1]} (${r[2]}), ${r[3]}, ${r[5]}. Postal code ${r[7].join(', ')}.`;
    deal(r);
    document.dispatchEvent(new CustomEvent<Row>('place-pick', { detail: r }));
  }

  async function loadRows() {
    if (!status) return;
    try {
      const res = await fetch('/data/search.json');
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      rows = (await res.json()) as Row[];
      status.textContent = `${rows.length.toLocaleString('en')} subdistricts ready to search.`;
    } catch {
      status.textContent = 'The place list did not load. Reload the page to try again.';
    }
  }
  void loadRows();

  list?.addEventListener(
    'scroll',
    () => {
      if (list.scrollTop + list.clientHeight > list.scrollHeight - 200)
        grow(list.children.length + PAGE);
    },
    { passive: true },
  );
  list?.addEventListener('mousedown', (e) => {
    const li = (e.target as Element).closest<HTMLElement>('[role="option"]');
    if (!li) return;
    e.preventDefault();
    pick(Number(li.dataset.index));
  });

  input?.addEventListener('input', () => {
    if (!rows.length || !status) return;
    results = searchRows(rows, input.value);
    render();
    if (!input.value) return;
    status.textContent = results.length
      ? `${results.length.toLocaleString('en')} ${results.length === 1 ? 'place matches' : 'places match'}.`
      : 'No place matches. Try the Thai or English name, or a postal code.';
  });
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown' && results.length) {
      select((active + 1) % results.length);
      e.preventDefault();
    } else if (e.key === 'ArrowUp' && results.length) {
      select((active - 1 + results.length) % results.length);
      e.preventDefault();
    } else if (e.key === 'Enter') {
      pick(Math.max(active, 0));
      e.preventDefault();
    } else if (e.key === 'Escape') {
      results = [];
      render();
    }
  });
  input?.addEventListener('blur', () => {
    results = [];
    render();
  });

  if (!reduce) {
    gsap.set(cards, { rotation: (i) => ROT[i] ?? 0, y: (i) => LIFT[i] ?? 0 });
    const title = document.getElementById('hero-title');
    const words = title ? SplitText.create(title, { type: 'words', aria: 'auto' }).words : [];
    gsap
      .timeline({ defaults: { ease: 'power3.out' } })
      .from(words, { yPercent: 70, opacity: 0, duration: 0.9, stagger: 0.06 })
      .from('#hero-lead', { y: 16, opacity: 0, duration: 0.7 }, '-=0.5')
      .from('#hero-search', { y: 16, opacity: 0, duration: 0.6 }, '-=0.45')
      .from(
        cards,
        { y: 160, rotation: 0, opacity: 0, duration: 1, ease: 'expo.out', stagger: 0.09 },
        '-=0.35',
      );
  }
</script>
