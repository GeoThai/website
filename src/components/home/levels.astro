---
import Container from '@/components/ui/container.astro';
import { loadData, startPlace } from '@/lib/data';

const { provinces, districts, subdistricts } = await loadData();
const { province: prov, district: dist, subdistrict: sub } = await startPlace();

const rows = [
  { id: 'province', code: prov.code, name: prov.name_en, count: provinces.length, noun: 'provinces' },
  { id: 'district', code: dist.code, name: dist.name_en, count: districts.length, noun: 'districts' },
  { id: 'subdistrict', code: sub.code, name: sub.name_en, count: subdistricts.length, noun: 'subdistricts' },
];
---

<section id="data" aria-labelledby="levels-title" class="py-18 md:py-36">
  <Container class="grid gap-8 md:grid-cols-5 md:gap-20">
    <div class="md:col-span-2">
      <h2 id="levels-title" class="max-w-md text-title font-semibold tracking-tight text-balance">Three levels, one code.</h2>
      <p id="levels-lead" class="mt-5 max-w-xl text-xl leading-normal text-pretty text-slate">
        Each code holds its parents. Read it from the left and you never need a second lookup.
      </p>
    </div>
    <ol id="levels" class="border-t border-line md:col-span-3">
      {
        rows.map((r) => (
          <li class="flex flex-col gap-1 border-b border-line py-6 md:flex-row md:items-baseline md:gap-6">
            <span data-level-code={r.id} class="text-title font-semibold tracking-tight tabular-nums md:w-48 md:shrink-0">
              {r.code}
            </span>
            <span class="text-slate">
              <span data-level-name={r.id}>{r.name}</span>, one of {r.count.toLocaleString('en')} {r.noun}
            </span>
          </li>
        ))
      }
    </ol>
  </Container>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';

  import type { Row } from '@/utils/search';

  const list = document.getElementById('levels');

  document.addEventListener('place-pick', (e) => {
    const r = (e as CustomEvent<Row>).detail;
    const values = {
      province: [r[0].slice(0, 2), r[6]],
      district: [r[0].slice(0, 4), r[4]],
      subdistrict: [r[0], r[2]],
    } as const;
    for (const [id, [code, name]] of Object.entries(values)) {
      const codeEl = list?.querySelector(`[data-level-code="${id}"]`);
      const nameEl = list?.querySelector(`[data-level-name="${id}"]`);
      if (codeEl) codeEl.textContent = code;
      if (nameEl) nameEl.textContent = name;
    }
  });

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && list) {
    gsap.registerPlugin(ScrollTrigger, SplitText);
    const title = document.getElementById('levels-title');
    const trigger = { trigger: '#data', start: 'top 80%', once: true };
    if (title) {
      const words = SplitText.create(title, { type: 'words', aria: 'auto' }).words;
      gsap.from(words, { yPercent: 60, opacity: 0, duration: 0.7, ease: 'power3.out', stagger: 0.045, scrollTrigger: trigger });
    }
    gsap.from('#levels-lead', { y: 14, opacity: 0, duration: 0.6, delay: 0.25, ease: 'power2.out', scrollTrigger: trigger });
    gsap.from(list.children, { x: -24, opacity: 0, duration: 0.6, ease: 'power2.out', stagger: 0.12, scrollTrigger: { ...trigger, trigger: list } });
  }
</script>
