---
import Container from '@/components/ui/container.astro';
import { loadData, startPlace } from '@/lib/data';
import { num } from '@/utils/format';
import { areaSlug } from '@/utils/slug';

const { provinces, districts, subdistricts } = await loadData();
const { province: prov, district: dist, subdistrict: sub } = await startPlace();

const rows = [
  {
    id: 'province',
    href: `/${areaSlug(prov)}/`,
    code: prov.code,
    name: prov.name_en,
    count: provinces.length,
    noun: 'provinces',
  },
  {
    id: 'district',
    href: `/${areaSlug(prov)}/${areaSlug(dist)}/`,
    code: dist.code,
    name: dist.name_en,
    count: districts.length,
    noun: 'districts',
  },
  {
    id: 'subdistrict',
    href: `/${areaSlug(prov)}/${areaSlug(dist)}/${areaSlug(sub)}/`,
    code: sub.code,
    name: sub.name_en,
    count: subdistricts.length,
    noun: 'subdistricts',
  },
];
---

<section id="data" aria-labelledby="levels-title" class="py-18 md:py-36">
  <Container class="grid gap-8 md:grid-cols-5 md:gap-20">
    <div class="md:col-span-2">
      <h2 id="levels-title" class="max-w-md text-title font-semibold tracking-display text-balance">
        Three levels, one code.
      </h2>
      <p id="levels-lead" class="mt-5 max-w-xl text-xl leading-normal text-pretty text-slate">
        Each code holds its parents. Read it from the left and you never need a second lookup.
      </p>
    </div>
    <ol id="levels" class="border-t border-line md:col-span-3">
      {rows.map((r) => (
        <li class="flex flex-col gap-1 border-line border-b py-6 md:flex-row md:items-baseline md:gap-6">
          <span
            data-level-code={r.id}
            class="font-semibold text-title tabular-nums tracking-display md:w-48 md:shrink-0"
          >
            {r.code}
          </span>
          <span class="text-slate">
            <a
              data-level-name={r.id}
              href={r.href}
              class="text-black underline underline-offset-4 hover:no-underline"
            >
              {r.name}
            </a>
            , one of {num(r.count)} {r.noun}
          </span>
        </li>
      ))}
    </ol>
  </Container>
</section>

<script>
  import { revealSection } from '@/lib/motion';
  import type { Row } from '@/utils/search';
  import { areaSlug } from '@/utils/slug';

  const section = document.getElementById('data');
  const title = document.getElementById('levels-title');
  const list = document.getElementById('levels');

  document.addEventListener('place-pick', (e) => {
    const r = (e as CustomEvent<Row>).detail;
    const values = {
      province: [r[0].slice(0, 2), r[6]],
      district: [r[0].slice(0, 4), r[4]],
      subdistrict: [r[0], r[2]],
    } as const;
    for (const [id, [code, name]] of Object.entries(values)) {
      const codeEl = list?.querySelector(`[data-level-code="${id}"]`);
      const nameEl = list?.querySelector(`[data-level-name="${id}"]`);
      if (codeEl) codeEl.textContent = code;
      if (nameEl) nameEl.textContent = name;
    }
    const province = `/${areaSlug({ code: r[0].slice(0, 2), name_en: r[6] })}/`;
    const district = `${province}${areaSlug({ code: r[0].slice(0, 4), name_en: r[4] })}/`;
    list?.querySelector('a[data-level-name="province"]')?.setAttribute('href', province);
    const subdistrict = `${district}${areaSlug({ code: r[0], name_en: r[2] })}/`;
    list?.querySelector('a[data-level-name="district"]')?.setAttribute('href', district);
    list?.querySelector('a[data-level-name="subdistrict"]')?.setAttribute('href', subdistrict);
  });

  if (section && title && list)
    revealSection(section, title, document.getElementById('levels-lead'), [...list.children]);
</script>
