---
import Container from '@/components/ui/container.astro';

const sources = [
  {
    name: 'DOPA administrative codes',
    href: 'https://stat.bora.dopa.go.th/stat/statnew/statMenu/newStat/ccaa.php',
    gives: 'Codes, Thai and English names, abolish dates',
    role: 'Base data',
  },
  {
    name: 'thailand-geography-json',
    href: 'https://github.com/thailand-geography-data/thailand-geography-json',
    gives: 'One postal code per subdistrict',
    role: 'Base postal codes',
  },
  {
    name: 'Thailand Post booklet 2558',
    href: 'https://file.thailandpost.com/upload/content/2558_56a9d444d5276.pdf',
    gives: 'District codes and their exceptions',
    role: 'Adds codes for parts of a subdistrict, check',
  },
  {
    name: 'DOPA population file',
    href: 'https://stat.bora.dopa.go.th/new_stat/webPage/statByYear.php',
    gives: 'Subdistrict codes and Thai names each year',
    role: 'Check',
  },
  {
    name: 'Thailand Post office lists',
    href: 'https://data.go.th/dataset/thp-02',
    gives: 'Open offices and their codes',
    role: 'Check',
  },
  {
    name: 'Thai Wikipedia postal code list',
    href: 'https://th.wikipedia.org/wiki/รายการรหัสไปรษณีย์ไทย',
    gives: 'District codes, exceptions, merged codes',
    role: 'Check',
  },
  {
    name: 'kongvut and jquery.Thailand',
    href: 'https://github.com/kongvut/thai-province-data',
    gives: 'Postal codes from two community datasets',
    role: 'Check',
  },
];
---

<section id="checked" aria-labelledby="sources-title" class="py-18 md:py-36">
  <Container>
    <h2 id="sources-title" class="max-w-2xl text-title font-semibold tracking-tight text-balance">
      Seven sources read every value.
    </h2>
    <p id="sources-lead" class="mt-5 max-w-2xl text-xl leading-normal text-pretty text-slate">
      When they disagree, a person reviews the difference and decides before the data ships.
    </p>
    <ul id="sources" class="mt-12 border-t border-line">
      {sources.map((s) => (
        <li class="grid gap-1 border-line border-b py-5.5 md:grid-cols-12 md:gap-6">
          <a href={s.href} class="font-semibold underline-offset-4 hover:underline md:col-span-4">
            {s.name}
          </a>
          <span class="text-slate md:col-span-5">{s.gives}</span>
          <span class="text-slate md:col-span-3">{s.role}</span>
        </li>
      ))}
    </ul>
  </Container>
</section>

<script>
  import { revealSection } from '@/lib/motion';

  const section = document.getElementById('checked');
  const title = document.getElementById('sources-title');
  const list = document.getElementById('sources');
  if (section && title && list)
    revealSection(section, title, document.getElementById('sources-lead'), [...list.children]);
</script>
