---
import { cn } from '@/utils/cn';
import { num } from '@/utils/format';

type Props = { items: { n: number; label: string }[]; class?: string };

const { items, class: className } = Astro.props;
---

<dl
  class={cn(
    'grid gap-px overflow-hidden rounded-3xl bg-line',
    items.length === 2 && 'grid-cols-2',
    items.length === 3 && 'grid-cols-3',
    items.length === 4 && 'grid-cols-2 sm:grid-cols-4',
    className,
  )}
>
  {items.map((t) => (
    <div class="flex flex-col justify-between gap-1 bg-mist px-5 py-4">
      <dt class="text-slate text-sm">{t.label}</dt>
      <dd class="font-semibold text-2xl tabular-nums tracking-tight">{num(t.n)}</dd>
    </div>
  ))}
</dl>
