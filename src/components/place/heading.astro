---
import Breadcrumb from '@/components/place/breadcrumb.astro';

type Props = {
  trail: { label: string; href?: string }[];
  /** Small line above the title: the area code, or a label. */
  kicker: string;
  title: string;
};

const { trail, kicker, title } = Astro.props;
---

<div>
  <Breadcrumb trail={trail} />
  <p class="mt-10 font-mono text-slate tabular-nums">{kicker}</p>
  <h1 id="place-title" class="mt-2 text-display font-semibold tracking-tight text-balance">
    {title}
  </h1>
  <p id="place-lead" class="mt-3 text-xl text-slate">
    <slot />
  </p>
</div>
