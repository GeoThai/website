---
import Breadcrumb from '@/components/place/breadcrumb.astro';

type Props = {
  trail: { label: string; href?: string }[];
  title: string;
};

const { trail, title } = Astro.props;
---

<div>
  <Breadcrumb trail={trail} />
  <h1 id="place-title" class="mt-10 text-display font-semibold tracking-display text-balance">
    {title}
  </h1>
  <p id="place-lead" class="mt-3 text-xl text-slate">
    <slot />
  </p>
</div>
