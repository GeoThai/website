---
import { render, toSvg } from '@geothai/maps';
import type { MapShapes } from '@geothai/maps/types';

import { cn } from '@/utils/cn';

type Props = {
  /** The areas to draw: `provinces`, or `await districtMap('84')`. */
  map: MapShapes;
  /** Link of each area page, by code. */
  hrefs: Record<string, string>;
  /** Area to draw in black: the area of the current page. */
  current?: string;
  /** More fills by code, such as the subdistricts that use a postal code. */
  fills?: Record<string, string>;
  /** Text under the map. */
  caption?: string;
  title: string;
  class?: string;
};

const { map, hrefs, current, fills = {}, caption, title, class: className } = Astro.props;
// A new khwaeng in Bangkok can sit inside an older shape that lists it in `codes`.
const here = map.shapes.find((s) => current && (s.codes ?? [s.code]).includes(current))?.code;
// Say so when a marked shape stands for several areas, so the map does not overstate one.
const merged = map.shapes
  .filter((s) => s.codes && (s.code === here || fills[s.code]))
  .map(
    (s) => `The boundary lines from 2022 draw ${s.name_en.replaceAll(' / ', ' and ')} as one area.`,
  );
const note = [caption, ...merged].filter(Boolean).join(' ');
const svg = toSvg(
  render(map, {
    title,
    fill: '#ffffff',
    fills: here ? { ...fills, [here]: '#000000' } : fills,
    stroke: '#5e636b',
    href: (s) => (s.code === here ? undefined : hrefs[s.code]),
    label: (s) => `${s.name_th} ${s.name_en}`,
  }),
);
---

<figure data-tooltips class={cn('area-map relative rounded-panel bg-mist p-6 md:p-10', className)}>
  {Astro.slots.has('inset') && (
    <div class="mb-4 flex justify-end md:pointer-events-none md:absolute md:top-10 md:right-10 md:mb-0">
      <slot name="inset" />
    </div>
  )}
  <div class="area-map-shape mx-auto max-w-xl" set:html={svg} />
  {note && <figcaption class="mt-5 text-center text-slate text-sm">{note}</figcaption>}
</figure>

<style>
  .area-map-shape :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    max-height: min(30rem, 70vh);
  }
  .area-map :global(a path) {
    transition: fill 150ms ease-out;
  }
  .area-map :global(a:hover path),
  .area-map :global(a:focus-visible path) {
    fill: var(--color-line);
  }
  .area-map :global(a:focus-visible) {
    outline: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .area-map :global(a path) {
      transition: none;
    }
  }
</style>
